// Copy the "namingtool" server block into your VS Code user or workspace
// settings.json under "mcp.servers" (or .vscode/mcp.json), then reload VS Code.
//
// After you run infra/configure-apim-mcp.ps1 you will have:
//   URL  = https://apim-namingtool-we.azure-api.net/namingtool-mcp/mcp
//   KEY  = <APIM subscription primary key printed by the script>
//
// Note: the final "/mcp" segment is the MCP protocol endpoint that APIM's
// MCP runtime appends on top of the MCP API path ("namingtool-mcp").
//
// Authentication to APIM uses the Ocp-Apim-Subscription-Key header.
{
  "servers": {
    "namingtool": {
      "type": "http",
      "url": "https://apim-namingtool-we.azure-api.net/namingtool-v2-mcp/mcp",
      "headers": {
        "Ocp-Apim-Subscription-Key": "fc46f175b2824fa1bdd64c6d7e5fea08"
      }
    }
  }
}
